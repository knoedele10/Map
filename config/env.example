# Optional overrides; set these in PowerShell before running start.ps1.
# Secrets stay in environment variables, never in the frontend.
# RAG_CHAT_PROVIDER=openai
# RAG_CHAT_BASE_URL=https://your-provider.example/v1
# RAG_CHAT_MODEL=your-text-model
# RAG_CHAT_API_KEY=
# RAG_VISION_ENABLED=true
# RAG_VISION_PROVIDER=openai
# RAG_VISION_BASE_URL=https://your-provider.example/v1
# RAG_VISION_MODEL=your-vision-model
# RAG_VISION_API_KEY=
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_BASE_URL=https://your-provider.example/v1
# RAG_EMBEDDING_MODEL=your-embedding-model
# RAG_EMBEDDING_DIM=1024
# RAG_EMBEDDING_API_KEY=
